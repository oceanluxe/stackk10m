{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "scripts": {
    "dev:client": "node ./node_modules/vite/bin/vite.js dev --port 3000",
    "dev": "cross-env NODE_ENV=development tsx server/index-dev.ts",
    "dev:ws": "cross-env NODE_ENV=development tsx server/index-ws.ts",
    "build": "vite build && esbuild server/index-prod.ts --platform=node --packages=external --bundle --format=esm --outfile=dist-server/index.js && esbuild server/index-ws.ts --platform=node --packages=external --bundle --format=esm --outfile=dist-server/ws.js && esbuild server/index-vercel.ts --platform=node --packages=external --bundle --format=esm --outfile=dist-server/vercel.js",
    "migrate": "tsx server/scripts/apply-migrations.ts",
    "audit:cleanup": "tsx server/scripts/audit-residue-cleanup.ts",
    "tasks:backfill-legacy": "tsx server/scripts/backfill-legacy-tasks.ts",
    "vercel-build": "npx --yes tsx server/scripts/vercel-build.ts",
    "start": "cross-env NODE_ENV=production node dist-server/index.js",
    "start:ws": "cross-env NODE_ENV=production node dist-server/ws.js",
    "check": "node ./node_modules/typescript/bin/tsc",
    "db:push": "node ./node_modules/drizzle-kit/bin.cjs push",
    "test": "npm run test:unit",
    "test:unit": "node ./node_modules/vitest/vitest.mjs run tests",
    "test:smoke": "node ./node_modules/vitest/vitest.mjs run server/tests",
    "test:all": "node ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "playwright test",
    "security:audit": "npm audit --audit-level=high",
    "security:scan-secrets": "tsx server/scripts/scan-secrets.ts"
  },
  "notes": "removed framer motion dependency",
